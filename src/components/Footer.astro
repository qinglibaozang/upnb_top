---
// 自定义页脚：首页显示版权条，其他页面显示 Starlight 默认页脚结构
// 注意：不能 import 'virtual:starlight/components/Footer'，因为该模块已被本文件覆盖，会造成循环导入
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';

// 首页判断：用 request URL
const reqUrl = new URL(Astro.request.url);
const isHomepage = reqUrl.pathname === '/' || reqUrl.pathname === '/index.html';
---

{isHomepage ? (
	<footer class="zh-footer-bar sl-flex">
		<div class="zh-footer-bar__brand sl-flex">
			<span>© 2026 情礼宝藏</span>
			<a href="https://beian.miit.gov.cn" target="_blank" rel="noopener noreferrer">
				吉ICP备2022006636号-1
			</a>
		</div>
		<a class="zh-built-with" href="https://starlight.astro.build" target="_blank" rel="noopener noreferrer">
			由 Astro+Starlight 构建
		</a>
	</footer>
) : (
	<footer class="sl-flex">
		<div class="meta sl-flex">
			<EditLink />
			<LastUpdated />
		</div>
		<Pagination />
		<a class="zh-built-with" href="https://starlight.astro.build" target="_blank" rel="noopener noreferrer">
			由 Astro+Starlight 构建
		</a>
	</footer>
)}

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
	}
</style>
