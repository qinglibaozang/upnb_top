---
// 自定义页脚：
// 1) 文章流底部保留 Starlight 默认分页（Pagination）；
// 2) 版权 + 备案信息 + 编辑链接做成「固定底栏」：吸在视口底部、不随文章滚动上移，
//    样式与顶部导航栏一致（毛玻璃 blur16 + 提饱和、78% 不透明底、hairline 上边框、
//    向上投影、100vw 防滚动条变窄）——见 .zh-footer-bar 样式（zh.css）
// 注：更新时间已上移到文章标题下（PageTitle.astro），这里不再重复显示
// 注：kudos（构建信息）分支已删除——starlight 的 credits 默认 false 且未配置，
//     该分支恒假（死代码）；样式与 Icon/config 导入一并清理
import EditLink from 'virtual:starlight/components/EditLink';
import Pagination from 'virtual:starlight/components/Pagination';
---

<footer class="sl-flex">
	<Pagination />
</footer>

<footer class="zh-footer-bar sl-flex">
	<div class="zh-footer-bar__brand sl-flex">
		<span>© 2026 情礼宝藏</span>
		<a href="https://beian.miit.gov.cn" target="_blank" rel="noopener noreferrer">
			吉ICP备2022006636号-1
		</a>
	</div>
	<div class="zh-footer-bar__edit">
		<EditLink />
	</div>
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
	}
</style>
