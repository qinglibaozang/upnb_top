---
// 覆盖 nova 的 Header：移动端布局重排
// 移动端：左侧菜单按钮 → 居中标题 → 右侧 搜索+明暗切换
// 桌面端：保持原布局（标题靠左 → 导航 → 搜索框 → 社交/语言/明暗）
const { hasSidebar } = Astro.locals.starlightRoute

import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle'

import options from 'virtual:starlight-theme-nova/user-config'

const nav = options.nav ?? []

// 处理 nav 的国际化（单语言站点配置全是纯字符串，直接取字符串即可；
// 兼容 i18n 对象时取 root 键。注：此前实现引用了不存在的 route.currentLocale
// （恒 undefined 走 root）且 ?? v?.root 是同一键的两次访问——均已简化）
const getText = (v) => (typeof v === 'string' ? v : v?.root)
---

<div class="relative box-border flex h-full items-center gap-2">
  <!-- 移动端：左侧菜单抽屉按钮 -->
  {
    hasSidebar && (
      <div class="flex items-center md:hidden print:hidden">
        <MobileMenuToggle />
      </div>
    )
  }

  <!-- 标题：移动端绝对居中（zh-nav-title 在 zh.css 定义，不依赖 Tailwind 预编译）；桌面靠左 -->
  <div
    class="-m-3 zh-nav-title flex min-w-0 overflow-clip p-3"
  >
    <SiteTitle />
  </div>

  <!-- 桌面端：导航链接（移动端隐藏） -->
  <nav
    class="hidden flex-1 flex-row gap-4 overflow-x-auto py-3 pr-4 pl-4 text-sm font-medium md:flex xl:gap-6 xl:pl-6"
  >
    {
      nav.map((item) => (
        <a
          class="-m-1.5 rounded-md p-1.5 text-(--sl-color-gray-3) no-underline hover:text-(--sl-color-white) focus-visible:outline-offset-0"
          href={getText(item.href)}
        >
          {getText(item.label)}
        </a>
      ))
    }
  </nav>

  <!-- 右侧：搜索 + 明暗切换（移动端显示），桌面加宽搜索框 -->
  <div class="zh-nav-right flex items-center gap-2 print:hidden">
    <div class="zh-header-search">
      <Search />
    </div>
    <ThemeSelect />
    <div class="hidden items-center gap-2 md:flex">
      <SocialIcons />
      <LanguageSelect />
    </div>
  </div>
</div>
