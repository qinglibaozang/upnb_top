---
// 主题切换按钮：太阳/月亮图标，点击在明暗之间切换。
// 自实现（不依赖 astro-theme-toggle 包），复用 Starlight 原生主题系统
// （localStorage key: starlight-theme；html[data-theme] 属性，zh.css 的变量以此驱动）。
// 图标来源：Tabler Icons，MIT。
---

<button
	class="zh-theme-toggle"
	type="button"
	aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
	title={Astro.locals.t('themeSelect.accessibleLabel')}
>
	<svg
		class="zh-theme-toggle__icon zh-theme-toggle__icon--light"
		viewBox="0 0 24 24"
		width="1em"
		height="1em"
		aria-hidden="true"
		fill="currentColor"
	>
		<path
			d="M12 19a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1m-4.95-2.05a1 1 0 0 1 0 1.414l-1.414 1.414a1 1 0 1 1-1.414-1.414l1.414-1.414a1 1 0 0 1 1.414 0m11.314 0l1.414 1.414a1 1 0 0 1-1.414 1.414l-1.414-1.414a1 1 0 0 1 1.414-1.414m-5.049-9.836a5 5 0 1 1-2.532 9.674a5 5 0 0 1 2.532-9.674M4 11a1 1 0 0 1 0 2H2a1 1 0 0 1 0-2zm18 0a1 1 0 0 1 0 2h-2a1 1 0 0 1 0-2zM5.636 4.222L7.05 5.636A1 1 0 0 1 5.636 7.05L4.222 5.636a1 1 0 0 1 1.414-1.414m14.142 0a1 1 0 0 1 0 1.414L18.364 7.05a1 1 0 0 1-1.414-1.414l1.414-1.414a1 1 0 0 1 1.414 0M12 1a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0V2a1 1 0 0 1 1-1"
		/>
	</svg>
	<svg
		class="zh-theme-toggle__icon zh-theme-toggle__icon--dark"
		viewBox="0 0 24 24"
		width="1em"
		height="1em"
		aria-hidden="true"
		fill="currentColor"
	>
		<path
			d="M12 1.992a10 10 0 1 0 9.236 13.838c.341-.82-.476-1.644-1.298-1.31a6.5 6.5 0 0 1-6.864-10.787l.077-.08c.551-.63.113-1.653-.758-1.653h-.266l-.068-.006z"
		/>
	</svg>
</button>

<style>
	/* 2rem 圆角按钮，hover 浅灰底，点击微缩 */
	.zh-theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0.5rem;
		border: none;
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-text);
		cursor: pointer;
		transition:
			background-color 150ms ease,
			transform 150ms ease;
	}

	.zh-theme-toggle:hover {
		background-color: rgb(156 163 175 / 0.3);
	}

	.zh-theme-toggle:focus-visible {
		outline-offset: 1px;
	}

	.zh-theme-toggle:active {
		transform: scale(0.9);
	}

	.zh-theme-toggle__icon {
		display: block;
		width: 1rem;
		height: 1rem;
	}

	/* 图标按当前主题显隐（data-theme 由 Starlight 脚本维护，含 auto 解析后的实际值） */
	:global(:root[data-theme='dark']) .zh-theme-toggle__icon--light {
		display: none;
	}
	:global(:root[data-theme='dark']) .zh-theme-toggle__icon--dark {
		display: block;
	}
	:global(:root[data-theme='light']) .zh-theme-toggle__icon--dark {
		display: none;
	}
</style>

<script>
	// 点击切换明暗（dark ⇄ light）。写入 Starlight 的 storage key，
	// 与原生 ThemeSelect 完全兼容；图标显隐由 CSS 根据 data-theme 自动切换。
	document.addEventListener('click', (event) => {
		const button = event.target instanceof Element && event.target.closest('.zh-theme-toggle')
		if (!button) return

		const root = document.documentElement
		const current = root.dataset.theme === 'dark' ? 'dark' : 'light'
		const next = current === 'dark' ? 'light' : 'dark'
		root.dataset.theme = next
		root.style.colorScheme = next
		try {
			localStorage.setItem('starlight-theme', next)
		} catch {
			/* 隐私模式等场景忽略写入失败 */
		}
	})
</script>
