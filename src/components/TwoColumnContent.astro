---
// 覆盖 starlight 原生布局，保留 contentWidth 注宽能力。
// 为避免虚拟模块解析问题，直接在此实现 TwoColumnContent。
const entry = Astro.locals.starlightRoute.entry
const raw = entry.data.contentWidth as string | undefined

const PRESETS: Record<string, string> = {
	wide: '75rem',
	full: '100%',
}

const contentWidth = raw ? (PRESETS[raw] ?? raw) : undefined
---

<div style={contentWidth ? { '--sl-content-width': contentWidth } : undefined}>
	<div class="lg:sl-flex">
		{Astro.locals.starlightRoute.toc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)}
		<div class="main-pane">
			<slot />
		</div>
	</div>
</div>

<style>
	.main-pane {
		isolation: isolate;
	}

	@media (min-width: 72rem) {
		.right-sidebar-container {
			order: 2;
			position: relative;
			/* 占位固定 = 侧边栏宽：原生 max() 公式在宽屏（--sl-content-width 封顶）下
			   会把占位容器撑宽到 680px+，而 fixed 的右栏卡片只有 400px 贴视口右缘，
			   导致正文卡片与右栏之间露出 280px 空白带（宽屏断裂） */
			width: var(--sl-sidebar-width);
		}

		.right-sidebar {
			position: fixed;
			top: 0;
			/* 不画与正文之间的分割线：侧边栏背景与正文同色（zh.css），线反而割裂视觉 */
			border-inline-start: none;
			/* TOC 靠视口右侧：原生 width:100%（相对视口）会铺满整个视口盖住左侧边栏，
			   必须显式给固定宽度（--sl-sidebar-width 300px）+ 右缘贴视口 */
			inset-inline-end: 0;
			width: var(--sl-sidebar-width);
			padding-top: var(--sl-nav-height);
			height: 100vh;
			overflow-y: auto;
			scrollbar-width: none;
		}

		.main-pane {
			width: 100%;
		}

		:global([data-has-sidebar][data-has-toc]) .main-pane {
			/* 内容在正文卡片内居中：原生 auto 0（margin-left:auto）在修复断裂后
			   main-pane 变宽（延伸到右栏）时会把正文内容整体推到右侧，
			   左侧留出大片空白，标题/文章看起来不居中 */
			--sl-content-margin-inline: auto;

			order: 1;
			/* 正文卡片延伸到右栏卡片左缘：原生 min() 公式在宽屏下只到
			   contentWidth + 余量/2（1480px@2560），与 fixed 右栏（贴视口右缘 400px）
			   之间留下 280px 空白带。改为 100% - 右栏宽，卡片无缝衔接；
			   文字宽度仍受 --sl-content-width 约束，不随之变宽 */
			width: calc(100% - var(--sl-sidebar-width));
		}
	}
</style>
