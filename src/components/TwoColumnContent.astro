---
// 覆盖 starlight 原生布局，保留 contentWidth 注宽能力。
// 为避免虚拟模块解析问题，直接在此实现 TwoColumnContent。
const entry = Astro.locals.starlightRoute.entry
const raw = entry.data.contentWidth as string | undefined

const PRESETS: Record<string, string> = {
	wide: '75rem',
	full: '100%',
}

const contentWidth = raw ? (PRESETS[raw] ?? raw) : undefined
---

<div style={contentWidth ? { '--sl-content-width': contentWidth } : undefined}>
	<div class="lg:sl-flex">
		{Astro.locals.starlightRoute.toc && (
			<aside class="right-sidebar-container print:hidden">
				<div class="right-sidebar">
					<slot name="right-sidebar" />
				</div>
			</aside>
		)}
		<div class="main-pane">
			<slot />
		</div>
	</div>
</div>

<style>
	.main-pane {
		isolation: isolate;
	}

	@media (min-width: 72rem) {
		.right-sidebar-container {
			order: 2;
			position: relative;
			width: max(
				var(--sl-sidebar-width),
				calc(
					var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
				)
			);
		}

		.right-sidebar {
			position: fixed;
			top: 0;
			/* 不画与正文之间的分割线：侧边栏背景与正文同色（zh.css），线反而割裂视觉 */
			border-inline-start: none;
			/* TOC 靠视口右侧：原生 width:100%（相对视口）会铺满整个视口盖住左侧边栏，
			   必须显式给固定宽度（--sl-sidebar-width 300px）+ 右缘贴视口 */
			inset-inline-end: 0;
			width: var(--sl-sidebar-width);
			padding-top: var(--sl-nav-height);
			height: 100vh;
			overflow-y: auto;
			scrollbar-width: none;
		}

		.main-pane {
			width: 100%;
		}

		:global([data-has-sidebar][data-has-toc]) .main-pane {
			--sl-content-margin-inline: auto 0;

			order: 1;
			width: min(
				calc(100% - var(--sl-sidebar-width)),
				calc(
					var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
				)
			);
		}
	}
</style>
