---
// 覆盖 starlight 默认 PageTitle：文章页头部"门户化"
// 标题下方元信息：description + 更新时间（原本在页脚的 LastUpdated 移到这里，
// 与页脚 EditLink 分工，避免更新时间重复显示）
//
// 数据来源：
// - 更新时间：Astro.locals.starlightRoute.lastUpdated

const { entry, lastUpdated, lang } = Astro.locals.starlightRoute;

const title = entry.data.title;
const description = entry.data.description as string | undefined;
// jieba 中文分词关键词（content loader 构建时生成）：隐藏注入页面，
// Pagefind 构建索引时按 HTML 解析（不看渲染/隐藏），分词词被索引为独立词，
// 配合查询端 jieba 分词实现中文短词/组合词召回
const searchKeywords = entry.data.searchKeywords ?? [];

// 更新时间：直接取 starlight 标准 lastUpdated（frontmatter 或 git 历史生成）。
// 注：此前有「回退到 frontmatter date 字段」的分支——该字段未在 content schema 注册，
// 会被 Zod 剥离恒为 undefined，分支恒不生效（死代码），已删除。
const metaDate: Date | undefined =
	lastUpdated instanceof Date ? lastUpdated : lastUpdated ? new Date(String(lastUpdated)) : undefined;
---

<h1 id="_top" data-page-title>{title}</h1>

<!-- 搜索分词注入：hidden 对 Pagefind 无影响（HTML 解析层索引），aria-hidden 防屏幕阅读器朗读 -->
{
	searchKeywords.length > 0 && (
		<div class="zh-search-words" hidden aria-hidden="true">{searchKeywords.join(' ')}</div>
	)
}

{
	description && <p class="zh-page-desc">{description}</p>
}

{
	metaDate && (
		<p class="zh-page-meta">
			<span>更新于</span>
			<time datetime={metaDate.toISOString()}>
				{metaDate.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
			</time>
		</p>
	)
}

<style>
	/* 复刻 starlight 默认 PageTitle 的 h1 样式（覆盖组件后原组件样式不生效） */
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
